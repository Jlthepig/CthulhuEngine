#version 1.0
#global
compilerlauncher: ccache
compiler: clang-cl
standard: c++20
binarytype: executable
binaryname: SandboxSample
sources: "src"
headers: "..\\Libraries\\GLFW\\include\\GLFW", "..\\Libraries\\GLM", "..\\Libraries\\glad", "..\\Libraries\\Stb_image", "..\\Libraries\\simdjson", "..\\Libraries", "..\\Libraries\\ImGui", "..\\Libraries\\JoltPhysics-5.5.0", "..\\Libraries\\flecs", "..\\include\\core", "..\\include\\rendering", "..\\include\\scene", "..\\include\\utils", "..\\include\\physics\\"

customflags: export-compile-commands, export-vscode-sln, warnings-as-errors

links: opengl32
compileflags: FS

warninglevel: strict

#profile release-windows
    buildtype: release
    buildpath: "build\\release-windows"
    
    links: "..\\build\\release-windows\\Cthulhu.lib", "..\\Libraries\\GLAD\\build\\release-windows\\glad.lib", "..\\Libraries\\GLFW\\build\\release-windows\\glfw3.lib", "..\\Libraries\\FASTTGLTF\\fastgltf\\build\\release-windows\\fastGltf.lib", "..\\Libraries\\ImGui\\build\\release-windows\\imgui.lib", "..\\Libraries\\JoltPhysics-5.5.0\\build\\distribution-windows\\Jolt.lib", "..\\Libraries\\flecs\\build\\release-windows\\flecs.lib"
    defines: _GLFW_WIN32

#profile debug-windows
    buildtype: debug
    buildpath: "build\\debug-windows"
    
    links: "..\\build\\debug-windows\\Cthulhu.lib", "..\\Libraries\\GLAD\\build\\debug-windows\\glad.lib", "..\\Libraries\\GLFW\\build\\debug-windows\\glfw3.lib", "..\\Libraries\\FASTTGLTF\\fastgltf\\build\\debug-windows\\fastGltf.lib", "..\\Libraries\\ImGui\\build\\debug-windows\\imgui.lib", "..\\Libraries\\JoltPhysics-5.5.0\\build\\debug-windows\\Jolt.lib", "Libraries\\flecs\\build\\debug-windows\\flecs.lib"
    defines: _GLFW_WIN32, JPH_ENABLE_ASSERTS