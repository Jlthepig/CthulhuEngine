#version 1.0
#global
compilerlauncher: ccache
compiler: clang-cl
standard: c++20 
binarytype: static
binaryname: Cthulhu
sources: "src"
headers: "include", "Libraries\\GLFW\\include\\GLFW", "Libraries\\GLM", "Libraries\\glad", "Libraries\\Stb_image", "Libraries\\simdjson", "Libraries\\JoltPhysics-5.5.0", "Libraries\\flecs", "Libraries\\FASTTGLTF", "Libraries\\miniaudio", "include\\core", "include\\rendering", "include\\scene", "include\\utils", "include\\physics\\", "include\\project"

customflags: export-compile-commands, export-vscode-sln, warnings-as-errors

links: opengl32
compileflags: Z7

warninglevel: strict

#profile release-windows
    buildtype: release
    buildpath: "build\\release-windows"
    
    compileflags: Z7, O2, Gw, Gy
    
    linkflags: IGNORE:4006, OPT:REF, OPT:ICF
    
    links: "Libraries\\GLAD\\build\\release-windows\\glad.lib", "Libraries\\GLFW\\build\\release-windows\\glfw3.lib", "Libraries\\FASTTGLTF\\fastgltf\\build\\release-windows\\fastGltf.lib", "Libraries\\JoltPhysics-5.5.0\\build\\distribution-windows\\Jolt.lib", "Libraries\\flecs\\build\\release-windows\\flecs.lib"
    
    defines: _GLFW_WIN32, GLFW_INCLUDE_NONE



#profile debug-windows
    buildtype: debug
    buildpath: "build\\debug-windows"
    compileflags: Z7, Od
    linkflags: IGNORE:4006
    links: "Libraries\\GLAD\\build\\debug-windows\\glad.lib", "Libraries\\GLFW\\build\\debug-windows\\glfw3.lib", "Libraries\\FASTTGLTF\\fastgltf\\build\\debug-windows\\fastGltf.lib", "Libraries\\JoltPhysics-5.5.0\\build\\debug-windows\\Jolt.lib", "Libraries\\flecs\\build\\debug-windows\\flecs.lib"
    
    defines: _GLFW_WIN32, GLFW_INCLUDE_NONE, JPH_ENABLE_ASSERTS
