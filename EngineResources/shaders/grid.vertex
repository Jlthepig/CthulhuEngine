#version 430 core

uniform mat4 inverseViewProjection;

out vec3 nearPoint;
out vec3 farPoint;

void main()
{
    const vec2 positions[3] = vec2[3](
        vec2(-1.0, -1.0),
        vec2(3.0, -1.0),
        vec2(-1.0, 3.0));

    vec2 position = positions[gl_VertexID];
    vec4 nearWorld = inverseViewProjection * vec4(position, -1.0, 1.0);
    vec4 farWorld = inverseViewProjection * vec4(position, 1.0, 1.0);

    nearPoint = nearWorld.xyz / nearWorld.w;
    farPoint = farWorld.xyz / farWorld.w;
    gl_Position = vec4(position, 0.0, 1.0);
}