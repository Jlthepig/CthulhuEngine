#version 430 core
layout (location = 0) in vec3 aPos;

out vec3 fragPos;

// Pull camera matrices directly from the global Scene UBO
layout(std140, binding = 0) uniform SceneData {
    mat4 view;
    mat4 projection;
    vec3 viewPos;
    // Remaining UBO members omitted since grid vertex only needs these two
};

uniform mat4 model;

void main()
{
    fragPos = vec3(model * vec4(aPos, 1.0));
    gl_Position = projection * view * model * vec4(aPos, 1.0);
}