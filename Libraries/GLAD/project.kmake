#version 1.0
#global
compiler: clang-cl
standard: c++20
binarytype: static
binaryname: glad
sources: "glad.c"

customflags: export-compile-commands, export-vscode-sln
headers: "."

#profile release-windows
    buildtype: minsizerel
    buildpath: "build/release-windows"
    
#profile debug-windows
    buildtype: debug
    buildpath: "build/debug-windows"

// vcvars64.bat && kalamake --compile glad.kmake debug-windows && vcvars64.bat && kalamake --compile glad.kmake release-windows