#version 400 core
out vec4 FragColor;

in vec2 TexCoord;
in vec3 FragPos;
in vec3 Normal;
in vec4 FragPosLightSpace;

uniform sampler2D uTexture;
uniform sampler2D uMetallicRoughnessTexture;
uniform sampler2D uNormalMap; 
uniform sampler2D uShadowMap;

uniform vec3 uLightDir;
uniform vec3 uLightColor;
uniform float uLightIntensity;
uniform vec4 uBaseColorFactor;
uniform float uMetallicFactor;
uniform float uRoughnessFactor;

struct PointLight
{
    vec3 position;
    vec3 color;
    float intensity;
    float constant;
    float linear;
    float quadratic;
};

#define MAX_POINT_LIGHTS 8
uniform PointLight uPointLights[MAX_POINT_LIGHTS];
uniform int uPointLightCount;

#define MAX_POINT_SHADOW_CASTERS 4
uniform samplerCube uPointShadowMaps[MAX_POINT_SHADOW_CASTERS];
uniform float uPointShadowFarPlane;
uniform int uPointShadowCount;

uniform vec3 uViewPos;

float samplePointShadowMap(int index, vec3 dir)
{
    if (index == 0) return texture(uPointShadowMaps[0], dir).r;
    if (index == 1) return texture(uPointShadowMaps[1], dir).r;
    if (index == 2) return texture(uPointShadowMaps[2], dir).r;
    if (index == 3) return texture(uPointShadowMaps[3], dir).r;
    return 1.0;
}

float calculatePointShadow(int index, vec3 fragPos, vec3 lightPos)
{
     vec3 fragToLight = fragPos - lightPos;
    float currentDepth = length(fragToLight);
    float closestDepth = texture(uPointShadowMaps[index], normalize(fragToLight)).r * uPointShadowFarPlane;
    float bias = currentDepth * 0.01;
    return clamp(currentDepth - bias > closestDepth ? 1.0 : 0.0, 0.0, 1.0);
}

float calculateShadow(vec4 fragPosLightSpace, vec3 norm, vec3 lightDir)
{
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords = projCoords * 0.5 + 0.5;

    if (projCoords.z > 1.0)
        return 0.0;

    float shadow = 0.0;
    vec2 texelSize = 1.0 / textureSize(uShadowMap, 0);

    for (int x = -1; x <= 1; x++)
    {
        for (int y = -1; y <= 1; y++)
        {
            float pcfDepth = texture(uShadowMap, projCoords.xy + vec2(x, y) * texelSize).r;
            float bias = max(0.05 * (1.0 - dot(norm, lightDir)), 0.005);
            shadow += projCoords.z - bias > pcfDepth ? 1.0 : 0.0;
        }
    }

    return shadow / 9.0;
}


void main()
{
    vec3 norm = normalize(Normal);
    vec3 viewDir = normalize(uViewPos - FragPos);
    vec4 texColor = texture(uTexture, TexCoord) * uBaseColorFactor;

    vec3 lightDir = normalize(-uLightDir);
    vec3 ambient = 0.15 * uLightColor;
    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = diff * uLightColor * uLightIntensity;
    vec3 halfDir = normalize(lightDir + viewDir);
    float spec = pow(max(dot(norm, halfDir), 0.0), 32.0);
    vec3 specular = 0.3 * spec * uLightColor;
    float shadow = calculateShadow(FragPosLightSpace, norm, lightDir);
    vec3 dirLightResult = ambient + (1.0 - shadow) * (diffuse + specular);

    vec3 pointLightResult = vec3(0.0);
    for (int i = 0; i < uPointLightCount; i++)
    {
        vec3 plDir = normalize(uPointLights[i].position - FragPos);
        float dist = length(uPointLights[i].position - FragPos);
        float att = 1.0 / (uPointLights[i].constant + uPointLights[i].linear * dist + uPointLights[i].quadratic * (dist * dist));
        float d = max(dot(norm, plDir), 0.0);
        vec3 pd = d * uPointLights[i].color * uPointLights[i].intensity * att;
        vec3 ph = normalize(plDir + viewDir);
        float ps = pow(max(dot(norm, ph), 0.0), 32.0);
        vec3 pspec = 0.3 * ps * uPointLights[i].color * att;

        float pshadow = 0.0;
        if (i < uPointShadowCount)
        {
            vec3 fragToLight = FragPos - uPointLights[i].position;
            float currentDepth = length(fragToLight);
            float closestDepth = texture(uPointShadowMaps[i], normalize(fragToLight)).r * uPointShadowFarPlane;
            float bias = currentDepth * 0.01;
            pshadow = currentDepth - bias > closestDepth ? 1.0 : 0.0;
        }

        pointLightResult += (1.0 - pshadow) * (pd + pspec);
    }

    vec3 result = (dirLightResult + pointLightResult) * texColor.rgb;
    result = result / (result + vec3(1.0));
    FragColor = vec4(result, 1.0);
}