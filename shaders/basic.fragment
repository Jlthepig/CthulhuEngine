#version 400 core
out vec4 FragColor;

in vec2 TexCoord;
in vec3 FragPos;
in mat3 TBN;
in vec4 FragPosLightSpace;

uniform sampler2D uTexture;
uniform sampler2D uMetallicRoughnessTexture;
uniform sampler2D uNormalMap;
uniform sampler2D uShadowMap;
uniform samplerCube uIrradianceMap;
uniform sampler2D uBRDFLUT;

uniform vec3 uLightDir;
uniform vec3 uLightColor;
uniform float uLightIntensity;
uniform vec4 uBaseColorFactor;
uniform float uMetallicFactor;
uniform float uRoughnessFactor;

struct PointLight {
    vec3 position;
    vec3 color;
    float intensity;
    float constant;
    float linear;
    float quadratic;
};

#define MAX_POINT_LIGHTS 8
uniform PointLight uPointLights[MAX_POINT_LIGHTS];
uniform int uPointLightCount;

#define MAX_POINT_SHADOW_CASTERS 4
uniform samplerCube uPointShadowMaps[MAX_POINT_SHADOW_CASTERS];
uniform float uPointShadowFarPlane;
uniform int uPointShadowCount;

uniform vec3 uViewPos;

const float PI = 3.14159265359;

// PBR Functions
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / (PI * denom * denom + 0.0000001);
}

float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0; // Direct lighting remap
    return NdotV / (NdotV * (1.0 - k) + k + 0.0000001);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return GeometrySchlickGGX(NdotV, roughness) * GeometrySchlickGGX(NdotL, roughness);
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness) {
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// Shadow Functions
float calculateShadow(vec4 fragPosLightSpace, vec3 norm, vec3 lightDir) {
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords = projCoords * 0.5 + 0.5;
    if (projCoords.z > 1.0) return 0.0;
    float shadow = 0.0;
    vec2 texelSize = 1.0 / textureSize(uShadowMap, 0);
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            float pcfDepth = texture(uShadowMap, projCoords.xy + vec2(x, y) * texelSize).r;
            float bias = max(0.05 * (1.0 - dot(norm, lightDir)), 0.005);
            shadow += projCoords.z - bias > pcfDepth ? 1.0 : 0.0;
        }
    }
    return shadow / 9.0;
}

void main() {
    // Normal Mapping Calculation
    vec3 normalMap = texture(uNormalMap, TexCoord).rgb;
    normalMap = normalMap * 2.0 - 1.0; // Remap from [0,1] to [-1,1]
    vec3 N = normalize(TBN * normalMap); // Transform to World Space

    vec3 V = normalize(uViewPos - FragPos);

    // 1. Material Properties
    vec3 albedo = texture(uTexture, TexCoord).rgb * uBaseColorFactor.rgb;
    float roughness = texture(uMetallicRoughnessTexture, TexCoord).g * uRoughnessFactor;
    float metallic = texture(uMetallicRoughnessTexture, TexCoord).b * uMetallicFactor;
    roughness = max(roughness, 0.04);

    // 2. F0
    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, albedo, metallic);

    vec3 Lo = vec3(0.0);

    // 3. Directional Light
    {
        vec3 L = normalize(-uLightDir);
        vec3 H = normalize(V + L);
        
        float shadow = calculateShadow(FragPosLightSpace, N, L);
        vec3 radiance = uLightColor * uLightIntensity * (1.0 - shadow);

        float NDF = DistributionGGX(N, H, roughness);
        float G = GeometrySmith(N, V, L, roughness);
        vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);

        vec3 numerator = NDF * G * F;
        float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
        vec3 specular = numerator / denominator;

        vec3 kS = F;
        vec3 kD = vec3(1.0) - kS;
        kD *= 1.0 - metallic;

        float NdotL = max(dot(N, L), 0.0);
        Lo += (kD * albedo / PI + specular) * radiance * NdotL;
    }

    // 4. Point Lights
    for (int i = 0; i < uPointLightCount; i++) {
        vec3 L = normalize(uPointLights[i].position - FragPos);
        vec3 H = normalize(V + L);
        
        float dist = length(uPointLights[i].position - FragPos);
        float attenuation = 1.0 / (uPointLights[i].constant + uPointLights[i].linear * dist + uPointLights[i].quadratic * (dist * dist));
        
        float pshadow = 0.0;
        if (i < uPointShadowCount) {
            vec3 fragToLight = FragPos - uPointLights[i].position;
            float currentDepth = length(fragToLight);
            float closestDepth = texture(uPointShadowMaps[i], normalize(fragToLight)).r * uPointShadowFarPlane;
            float bias = currentDepth * 0.01;
            pshadow = currentDepth - bias > closestDepth ? 1.0 : 0.0;
        }

        vec3 radiance = uPointLights[i].color * uPointLights[i].intensity * attenuation * (1.0 - pshadow);

        float NDF = DistributionGGX(N, H, roughness);
        float G = GeometrySmith(N, V, L, roughness);
        vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);

        vec3 numerator = NDF * G * F;
        float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
        vec3 specular = numerator / denominator;

        vec3 kS = F;
        vec3 kD = vec3(1.0) - kS;
        kD *= 1.0 - metallic;

        float NdotL = max(dot(N, L), 0.0);
        Lo += (kD * albedo / PI + specular) * radiance * NdotL;
    }

        // 5. Ambient (Diffuse IBL)
        vec3 F = fresnelSchlickRoughness(max(dot(N, V), 0.0), F0, roughness);
        vec3 kD = (1.0 - F) * (1.0 - metallic);
        vec3 irradiance = texture(uIrradianceMap, N).rgb;
        vec3 diffuse = irradiance * albedo;
        
        // Use BRDF LUT for specular ambient
        vec3 R = reflect(-V, N);
        // Note: We will add the Pre-filtered Environment Map for R in the next step.
        // For now, we just use the BRDF LUT scaled by the Fresnel.
        vec2 brdf = texture(uBRDFLUT, vec2(max(dot(N, V), 0.0), roughness)).rg;
        vec3 specularAmbient = F * brdf.x + brdf.y; // Partial specular IBL
        
        vec3 ambient = kD * diffuse + specularAmbient * 0.5; // Temp scale down partial spec
        vec3 color = ambient + Lo;

    FragColor = vec4(color, 1.0);
}