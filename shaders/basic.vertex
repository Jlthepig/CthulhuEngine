#version 430 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aTexCoord;
layout (location = 3) in vec4 aTangent;

out vec2 TexCoord;
out vec3 FragPos;
out mat3 TBN;
out vec4 FragPosLightSpace;

struct PointLight {
    vec3 position;
    vec3 color;
    float intensity;
    float constant;
    float linear;
    float quadratic;
};

layout(std140, binding = 0) uniform SceneData {
    mat4 view;
    mat4 projection;
    vec3 viewPos;
    
    vec3 lightDir;
    float lightIntensity;
    float fogDensity;
    float fogHeightFalloff;
    int pointLightCount;
    
    vec3 lightColor;
    vec3 fogColor;
    int pointShadowCount;
    float pointShadowFarPlane;
    int pad1;
    int pad2;
    
    PointLight pointLights[8];
};

uniform mat4 model;
uniform mat4 lightSpaceMatrix;
uniform mat4 uNormalMatrix;

void main()
{
    gl_Position = projection * view * model * vec4(aPos, 1.0);
    TexCoord = aTexCoord;
    FragPos = vec3(model * vec4(aPos, 1.0));
    
    vec3 N = normalize(mat3(uNormalMatrix) * aNormal);
    vec3 T = mat3(uNormalMatrix) * aTangent.xyz;

    // SAFETY: If model has no tangents, T will be 0. Generate a fallback!
    if (length(T) < 0.01) {
        vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        T = normalize(cross(up, N));
    } else {
        T = normalize(T);
    }

    // Gram-Schmidt
    T = normalize(T - dot(T, N) * N);
    vec3 B = cross(N, T) * aTangent.w; // w is handedness
    
    TBN = mat3(T, B, N);

    FragPosLightSpace = lightSpaceMatrix * vec4(FragPos, 1.0);
}