#version 400 core
out vec4 FragColor;

in vec3 fragPos;

uniform vec3 cameraPos;
uniform float fadeDistance = 40.0;
void main()
{
    float dist = distance(fragPos, cameraPos);

    float alpha = 1.0 - smoothstep(fadeDistance * 0.5, fadeDistance, dist);

    float heightFade = 1.0 - smoothstep(5.0, 20.0, abs(fragPos.y - cameraPos.y));
    alpha *= heightFade;
    
    FragColor = vec4(1.0, 1.0, 1.0, alpha);
}